import("//build/config/ui.gni")

static_library("eye_dropper") {
  sources = [
    "eye_dropper_view.cc",
    "eye_dropper_view.h",
    "eye_dropper_view_aura.cc",
    # NW: kAllowEyeDropperWGCScreenCapture is also defined in
    # chrome/browser/ui/ui_features.cc (upstream duplicate; the BASE_FEATURE
    # macro emits the same unmangled symbol from both namespaces). libnw.so's
    # --whole-archive solink pulls in both copies and lld errors on the
    # duplicate. Drop this copy here; eye_dropper_view.cc's reference resolves
    # to the ui_features.o definition. Upstream links chrome as an executable
    # so the .a member is never force-loaded.
    # "features.cc",
    "features.h",
  ]

  deps = [
    "//base",
    "//components/color:color_headers",
    "//content/public/browser",
    "//third_party/abseil-cpp:absl",
    "//third_party/webrtc_overrides:webrtc_component",
    "//ui/base",
    "//ui/color",
    "//ui/gfx/geometry",
    "//ui/native_window_tracker",
    "//ui/views",
  ]
}

source_set("color_mixer") {
  sources = [
    "color_mixer.cc",
    "color_mixer.h",
  ]

  deps = [
    "//components/color:color_headers",
    "//ui/color",
  ]
}
