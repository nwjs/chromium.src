# NW.js: This target originally copied //package.json to $root_out_dir. NW.js
# launches its app from the build output directory, and a stray package.json
# there is picked up as the app manifest (it has no "name"), crashing startup
# in extensions::file_util::LoadExtension. Make it a no-op group so dependents
# (e.g. devtools-frontend) still resolve without polluting the output root.
group("copy_package_json") {
}
