[
    Exposed=Window,
    SecureContext,
    RuntimeEnabled=WebMCP
] interface ToolCancelEvent : Event {
    constructor(DOMString type, optional ToolCancelEventInit eventInitDict = {});
    readonly attribute DOMString toolName;
};

dictionary ToolCancelEventInit : EventInit {
    DOMString toolName = "";
};
